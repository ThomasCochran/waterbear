// ~/.config/waybar/config.jsonc — Waterbear "dashboard" bar (Super+W shows/hides it)
{
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "reload_style_on_change": true,
  "height": 26,
  "modules-left": [
    "hyprland/workspaces",
    "clock#date"
  ],
  "modules-center": [
    "clock#time"
  ],
  "modules-right": [
    "cpu",
    "custom/cputemp",
    "custom/gpu",
    "memory",
    "network",
    "wireplumber",
    "battery"
  ],
  "hyprland/workspaces": {
    "format": "{name}",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e+1\"})'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e-1\"})'",
    "persistent-workspaces": {
      "*": 3
    }
  },
  "clock#date": {
    "format": "  {:%a · %m/%d/%Y}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "clock#time": {
    "format": "{:%I:%M %p}",
    "tooltip": false
  },
  "cpu": {
    "format": "  {usage}%",
    "interval": 3
  },
  "custom/cputemp": {
    "exec": "~/.local/bin/waybar-sys.sh cputemp",
    "return-type": "json",
    "interval": 5
  },
  "custom/gpu": {
    "exec": "~/.local/bin/waybar-sys.sh gpu",
    "return-type": "json",
    "interval": 5,
    "format": "󰢮  {}"
  },
  "memory": {
    "format": "  {used:0.1f}G",
    "interval": 5,
    "tooltip-format": "{used:0.1f}G of {total:0.1f}G used"
  },
  "network": {
    "format-wifi": "󰖩",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "{ifname}"
  },
  "wireplumber": {
    "format": "󰕾  {volume}",
    "format-muted": "󰖁",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "battery": {
    "format": "{icon}  {capacity}",
    "format-charging": "󰂄  {capacity}",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁼",
      "󰁾",
      "󰂀",
      "󰁹"
    ],
    "states": {
      "warning": 25,
      "critical": 10
    },
    "tooltip-format": "{timeTo}"
  }
}
