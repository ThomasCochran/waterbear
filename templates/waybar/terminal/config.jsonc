// ~/.config/waybar/config.jsonc — Waterbear "terminal" bar (Super+W shows/hides it)
{
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "reload_style_on_change": true,
  "height": 22,
  "modules-left": [
    "hyprland/workspaces",
    "custom/cpumeter",
    "custom/gpumeter",
    "memory"
  ],
  "modules-right": [
    "tray",
    "network",
    "wireplumber",
    "battery",
    "clock"
  ],
  "tray": { "icon-size": 14, "spacing": 6 },
  "hyprland/workspaces": {
    "format": "{name}",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e+1\"})'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e-1\"})'",
    "persistent-workspaces": {
      "*": 3
    }
  },
  "custom/cpumeter": {
    "exec": "~/.local/bin/waybar-sys.sh cpu-meter",
    "return-type": "json",
    "interval": 3
  },
  "custom/gpumeter": {
    "exec": "~/.local/bin/waybar-sys.sh gpu-meter",
    "return-type": "json",
    "interval": 5
  },
  "memory": {
    "format": "mem:{used:0.1f}/{total:0.1f}G",
    "interval": 5
  },
  "network": {
    "format-wifi": "wlan:{essid}",
    "format-ethernet": "eth:up",
    "format-disconnected": "net:down"
  },
  "wireplumber": {
    "format": "vol:{volume}%",
    "format-muted": "vol:muted",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "battery": {
    "format": "bat:{capacity}%",
    "format-charging": "bat:{capacity}%+",
    "states": {
      "warning": 25,
      "critical": 10
    }
  },
  "clock": {
    "format": "{:%a %m/%d/%Y %I:%M %p}",
    "tooltip-format": "<tt>{calendar}</tt>"
  }
}
