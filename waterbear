#!/usr/bin/env bash
# waterbear — an Arch + Hyprland setup. https://github.com/ThomasCochran/waterbear
#
#   waterbear                 open the menu (also: Super+Alt+Space)
#   waterbear setup           install the Waterbear desktop with your saved settings (same as menu → Desktop → Install)
#   waterbear theme [NAME] [ACCENT]  switch color scheme (no name = the theme menu: presets, from a picture, your own colors)
#   waterbear background      pick your background (a generated one, or your own picture)
#   waterbear transparency [FOCUSED OTHERS]  window transparency in % (0 = solid, 100 = see-through)
#   waterbear dark [on|off]   dark mode for GTK / Qt apps and Firefox (no argument = switch)
#   waterbear bar [NAME]      dashboard | islands | terminal | none
#   waterbear shell [NAME]    bash | fish: the shell your terminals open
#   waterbear apps            install / remove apps, search any package, web apps
#   waterbear monitors        monitor order (left → right) and which workspaces go on which
#   waterbear update          snapshot, update the system and Waterbear, refresh configs
#   waterbear autoupdate [off|ask|auto]  no argument = check now (also runs at login, then every 3 hours)
#   waterbear snapshot [DESC] take a snapshot now
#   waterbear apply           rewrite all configs from your saved settings
#   waterbear shortcuts       list every keyboard shortcut (also: Super+H, or Super+K with Omarchy keys)
#   waterbear shortcut on|off the Super+Alt+Space shortcut that opens this menu
#   waterbear version         show which version is installed
#   waterbear help
#
# Setup options (for `waterbear setup`, or `./install.sh --desktop ...`):
#   --yes                 no questions, use the saved settings / defaults
#   --scheme NAME   --accent COLOR (Noir: white red orange yellow blue green purple pink)
#   --wallpaper solid|grid|orbit|logo|cmatrix|cava   --bar NAME   --prompt minimal|info|hacker|off
#   --shell bash|fish     --keybinds waterbear|omarchy|default     --light (light mode)
#   --apps "btop nvim ..."      --steam      --yay      --auto-update off|ask|auto
#   --login-screen  --text-login   --no-snapper   --no-firewall   --delete-old
set -euo pipefail

WB_SELF="$(readlink -f "${BASH_SOURCE[0]}")"
export WATERBEAR_HOME="${WATERBEAR_HOME:-$(dirname "$WB_SELF")}"
# shellcheck source=lib/core.sh
. "$WATERBEAR_HOME/lib/core.sh"
. "$WB_HOME/lib/menu.sh"
. "$WB_HOME/lib/apply.sh"
. "$WB_HOME/lib/apps.sh"
. "$WB_HOME/lib/system.sh"
. "$WB_HOME/lib/monitors.sh"
. "$WB_HOME/lib/palette.sh"

[[ $EUID -eq 0 ]] && die "Run waterbear as your normal user (it uses sudo when needed)."
command -v gum > /dev/null || INTERACTIVE=false
{ : < /dev/tty; } 2> /dev/null || INTERACTIVE=false   # no terminal to ask in (e.g. started from a hotkey without one)
OLD_CONFIGS=save

apply_quiet() { [[ "$DESKTOP" == yes ]] && apply_all; return 0; }   # refresh configs only if the desktop is installed

# ---------------------------------------------------------------------------
# Themes
# ---------------------------------------------------------------------------
theme_label() {  # one line for the theme list
    local t="$1" d
    d=$(scheme_desc "$t")
    [[ "$t" == custom ]] && d="trying it (not saved yet)"
    printf '%-12s  %s' "$t" "$d"
}

pick_accent() {  # for schemes like Noir that let you choose the accent color; prints it ("" = none to pick)
    local opts=() pair cur="${ACCENT:-$(scheme_accent_default "$1")}"
    while IFS= read -r pair; do
        opts+=("$(printf '%-7s' "${pair%%:*}") #${pair#*:}::${pair%%:*}")
    done < <(scheme_accents "$1")
    [[ ${#opts[@]} -eq 0 ]] && { echo ""; return 0; }
    ui_pick "Accent color for $1" "$cur" "${opts[@]}"
}

# Switch to a theme and write the configs. Your background stays as it is.
theme_switch() {  # theme_switch NAME [ACCENT]
    local new="$1" old="$SCHEME"
    if [[ "$new" == old_theme ]]; then
        [[ "$old" == old_theme ]] && { info "You're already on old_theme."; return 0; }
        if [[ "$DESKTOP" == yes ]]; then
            info "old_theme is your whole setup from before Waterbear: its Hyprland, kitty, bar and other configs"
            info "go back in place (Waterbear's are backed up). Pick any other theme to come back."
            ui_confirm "Switch to your setup from before Waterbear?" y || return 1
            old_theme_restore || return 1
        fi
        SCHEME=old_theme; ACCENT=""; state_save
        shortcut_apply
        reload_desktop
        return 0
    fi
    if [[ "$old" == old_theme && "$DESKTOP" == yes ]]; then
        shortcut_strip   # the shortcut block added to your old Hyprland config
        old_theme_leave
    fi
    SCHEME="$new"; ACCENT="${2:-}"
    if [[ -z "$ACCENT" && -n "$(scheme_accents "$SCHEME")" ]]; then
        scheme_load "$SCHEME"; ui_colors
        ACCENT=$(pick_accent "$SCHEME") || { SCHEME="$old"; return 1; }
    fi
    [[ -n "$ACCENT" && -z "$(scheme_accents "$SCHEME")" ]] && ACCENT=""
    scheme_load "$SCHEME"
    state_save
    if [[ "$DESKTOP" == yes ]]; then
        apply_all
        [[ "$old" == old_theme ]] && shortcut_apply
        ok "Theme: $P_NAME (new terminals pick it up; Neovim on next start)"
    else
        desktop_needed || true
    fi
}

menu_theme() {
    local last="$SCHEME"
    while true; do
        scheme_load "$SCHEME"; ui_colors
        ui_title "Theme"
        local opts=() t mine
        mine=$(scheme_user)
        if [[ -n "$mine" ]]; then
            opts+=("-- Your themes")
            for t in $mine; do opts+=("$(theme_label "$t")::$t"); done
        fi
        opts+=("-- Built-in")
        for t in $(scheme_builtin); do opts+=("$(theme_label "$t")::$t"); done
        if [[ -d "$OLD_THEME_DIR" ]]; then
            opts+=("-- Before Waterbear" "$(theme_label old_theme)::old_theme")
        fi
        opts+=("-- Make a theme"
               "From a picture   pick a picture, get a theme in its colors::@picture"
               "Your own colors  type a background, text and two accents::@colors")
        [[ "$SCHEME" == custom ]] && opts+=("Save the theme you're trying::@save")
        opts+=("-- Windows"
               "Transparency     window you're on $SEE_FOCUSED% · other windows $SEE_UNFOCUSED%::@transparency")
        [[ -n "$mine" ]] && opts+=("Manage your themes  rename · change colors · delete::@manage")
        local c
        c=$(ui_pick "Theme  (now: $SCHEME${ACCENT:+ · $ACCENT})" "$last" "${opts[@]}") || return 0
        last="$c"
        case "$c" in
            @picture) if theme_from_picture; then
                          local need; need=$(wallpaper_pkgs)
                          [[ -n "$need" && "$DESKTOP" == yes ]] && { need_sudo; pac $need; }
                          state_save
                          if [[ "$DESKTOP" == yes ]]; then apply_all; ok "Theme: $SCHEME"; else desktop_needed || true; fi
                          ui_pause
                      fi ;;
            @colors)  if theme_from_colors; then
                          state_save
                          if [[ "$DESKTOP" == yes ]]; then apply_all; ok "Theme: $SCHEME"; else desktop_needed || true; fi
                          ui_pause
                      fi ;;
            @save)    local n; n=$(theme_name_ask) || continue
                      mv "$WB_USER_SCHEMES/custom" "$WB_USER_SCHEMES/$n"
                      sed -i 's/ (not saved yet)"$/"/' "$WB_USER_SCHEMES/$n"
                      SCHEME="$n"; state_save; ok "Saved as $n."; ui_pause ;;
            @manage)  themes_manage ;;
            @transparency) if pick_transparency; then transparency_set; ui_pause; fi ;;
            *)        theme_switch "$c" && ui_pause || true ;;
        esac
    done
}

cmd_theme() {
    state_load
    if [[ -z "${1:-}" ]]; then
        $INTERACTIVE || die "Give a theme name: waterbear theme NAME (options: $(scheme_list | tr '\n' ' '))"
        menu_theme; return 0
    fi
    scheme_file "$1" > /dev/null || die "Unknown theme '$1'. Options: $(scheme_list | tr '\n' ' ')"
    local acc="${2:-}"
    [[ -z "$acc" && "$1" == "$SCHEME" ]] && acc="$ACCENT"
    [[ -z "$acc" && -n "$(scheme_accents "$1")" ]] && acc=$(scheme_accent_default "$1")
    theme_switch "$1" "$acc"
}

# ---------------------------------------------------------------------------
# Pickers shared by the menu and the command line
# ---------------------------------------------------------------------------
st_wallpaper() {
    local v
    v=$(ui_pick "Background  (your theme stays the same)" "$WALLPAPER" \
        "solid        your theme's background color::solid" \
        "picture      your own picture${WALL_IMAGE:+ (now: $(basename "$WALL_IMAGE"))}::picture" \
        "grid         synthwave grid horizon, in your theme's colors::grid" \
        "orbit        a ringed planet, in your theme's colors::orbit" \
        "logo         the waterbear logo, in your theme's colors::logo" \
        "matrix rain  live: cmatrix falling behind your windows::cmatrix" \
        "sound bars   live: cava bars that move with your music::cava") || return 1
    WALLPAPER="$v"
}

st_picture() {
    [[ "$WALLPAPER" == picture ]] || return 2
    if [[ -f "$WALL_IMAGE" ]]; then
        local k
        k=$(ui_pick "Background picture" keep "Keep $(basename "$WALL_IMAGE")::keep" "Pick another picture::new") || return 1
        [[ "$k" == keep ]] && return 0
    fi
    local img; img=$(pick_picture) || return 1
    WALL_IMAGE=$(picture_keep "$img")
}

st_live_battery() {
    [[ "$WALLPAPER" == cmatrix || "$WALLPAPER" == cava ]] || return 2
    local v; v=$(ui_yesno "Keep the live background running on battery? (No = solid color on battery, saves power)" "$LIVE_ON_BATTERY") || return 1
    LIVE_ON_BATTERY="$v"
}

st_lock_bg() {
    local v
    v=$(ui_pick "Lock screen background" "$LOCK_BG" \
        "solid      your theme's background color::solid" \
        "wallpaper  a blurred, dimmed copy of your background (image backgrounds only)::wallpaper") || return 1
    LOCK_BG="$v"
}

pick_wallpaper() { ui_steps st_wallpaper st_picture st_live_battery st_lock_bg; }

wallpaper_pkgs() {  # packages the chosen background needs
    case "$WALLPAPER" in
        grid|orbit|logo|picture) echo "hyprpaper librsvg" ;;
        cmatrix)                 echo "cmatrix" ;;
        cava)                    echo "cava" ;;
    esac
}

cmd_background() {
    pick_wallpaper || return 0
    local need p; need=$(wallpaper_pkgs)
    if [[ -n "$need" && "$DESKTOP" == yes ]]; then
        for p in $need; do pkg_installed "$p" || { need_sudo; pac $need; break; }; done
    fi
    state_save; apply_all
}

# Transparency: two percentages, 0 = solid, 100 = fully see-through
ask_percent() {  # ask_percent QUESTION DEFAULT -> prints 0-100
    local v
    while true; do
        v=$(ui_input "$1  (0 = solid · 100 = fully see-through)" "$2") || return 1
        v="${v%\%}"; v="${v// /}"
        [[ "$v" =~ ^[0-9]+$ ]] && (( v <= 100 )) && { echo "$v"; return 0; }
        warn "'$v' isn't a number from 0 to 100."
    done
}
st_see_focused()   { local v; v=$(ask_percent "Transparency of the window you're on (focused)" "$SEE_FOCUSED") || return 1; SEE_FOCUSED="$v"; }
st_see_unfocused() { local v; v=$(ask_percent "Transparency of the other windows" "$SEE_UNFOCUSED") || return 1; SEE_UNFOCUSED="$v"; }

pick_transparency() {
    ui_title "Transparency"
    info "How see-through windows are, in %: 0 = solid, 100 = fully see-through."
    info "Terminals keep their text solid and only their background fades, so 100 = floating text."
    info "Other apps fade as a whole, text included, so very high numbers make them hard to read."; echo
    ui_steps st_see_focused st_see_unfocused
}

transparency_set() {
    state_save
    if [[ "$DESKTOP" == yes ]]; then apply_all; else desktop_needed || true; fi
    ok "Transparency: window you're on $SEE_FOCUSED% · other windows $SEE_UNFOCUSED%"
}

pick_bar() {
    ui_pick "Status bar  (Super+W shows/hides it)" "$BAR" \
        "dashboard  full bar: date · 12h clock · CPU/GPU/memory · tray · wifi · volume · battery::dashboard" \
        "islands    four floating islands: workspaces · date/time · stats · tray/wifi/volume/battery::islands" \
        "terminal   text-only, htop-style meters::terminal" \
        "none       no bar (Super+I still pops up time/battery/wifi)::none"
}

pick_prompt() {
    ui_pick "Terminal prompt (Starship)" "$PROMPT" \
        "hacker   ┌─[tardigrade@laptop]─[~/dotfiles]─[main]   └─❯::hacker" \
        "info     ~/dotfiles on main via 3.14 took 3s   then ❯ on the next line::info" \
        "minimal  ~/dotfiles main ❯::minimal" \
        "off      the shell's own plain prompt (no Starship)::off"
}

pick_shell() {
    ui_pick "Terminal shell  (your login shell stays bash; this is what kitty opens)" "$USER_SHELL" \
        "bash  the classic. Same as every guide and script on the internet::bash" \
        "fish  friendly: suggestions as you type, colors, tab completion with descriptions::fish"
}

pick_keybinds() {
    ui_pick "Keyboard shortcuts  (full list: Keyboard → Shortcut list)" "$KEYBINDS" \
        "Waterbear  JaKooLit-style (Super+Enter terminal · Super+D apps · Super+Q close)::waterbear" \
        "Omarchy    like Omarchy (Super+Enter terminal · Super+Space apps · Super+W close · Super+K help)::omarchy" \
        "Hyprland   stock shortcuts (Super+Q terminal · Super+R apps · Super+C close)::default"
}

show_shortcuts() {  # the cheat sheet for the keybind set in use. Never exits the menu on a problem.
    local f="$HOME/.config/hypr/KEYBINDS.md" src="$WB_HOME/templates/hypr/KEYBINDS-$KEYBINDS.md"
    if [[ ! -f "$f" ]] || ! grep -qs "KEYBINDS" "$f"; then
        [[ -f "$src" ]] || { warn "No shortcut list found for the '$KEYBINDS' set ($src)."; ui_pause; return 0; }
        f="$src"
    fi
    if command -v less > /dev/null; then less "$f" || true
    elif command -v gum > /dev/null; then gum pager < "$f" || true
    else cat "$f"; ui_pause
    fi
    return 0
}

st_idle_preset() {
    local p
    p=$(ui_pick "Screensaver & lock timing (minutes: screensaver / lock / screen off / sleep)" "$IDLE_PRESET" \
        "short    2 / 3 / 5 / 15::short" \
        "normal   4 / 5 / 7 / 20::normal" \
        "long     9 / 10 / 15 / 30::long" \
        "custom   type your own::custom") || return 1
    if [[ "$p" == custom ]]; then IDLE_PRESET=custom; else idle_preset "$p"; fi
}

st_idle_custom() {
    [[ "$IDLE_PRESET" == custom ]] || return 2
    local s l o z v
    s=$(ui_input "Screensaver after (minutes, must be less than lock)" "$IDLE_SAVER") || return 1
    l=$(ui_input "Lock after (minutes)" "$IDLE_LOCK") || return 1
    o=$(ui_input "Screen off after (minutes)" "$IDLE_OFF") || return 1
    z=$(ui_input "Sleep after (minutes, 0 = never)" "$IDLE_SUSPEND") || return 1
    for v in "$s" "$l" "$o" "$z"; do
        [[ "$v" =~ ^[0-9]+$ ]] || { warn "'$v' isn't a number. Pick again."; ui_pause; return 1; }
    done
    IDLE_SAVER="$s"; IDLE_LOCK="$l"; IDLE_OFF="$o"; IDLE_SUSPEND="$z"
}

st_saver() {
    local v
    v=$(ui_pick "Screensaver" "$SAVER" \
        "cmatrix  Matrix rain::cmatrix" \
        "clock    big terminal clock::clock" \
        "off      no screensaver, just lock::off") || return 1
    SAVER="$v"
}

st_saver_battery() {
    [[ "$SAVER" != off ]] || return 2
    local v; v=$(ui_yesno "Run the screensaver on battery too? (No = go straight to lock to save power)" "$SAVER_ON_BATTERY") || return 1
    SAVER_ON_BATTERY="$v"
}

st_fw_on() {
    local v; v=$(ui_yesno "Use the firewall? (blocks incoming connections except what you allow)" "$FIREWALL") || return 1
    FIREWALL="$v"
}

st_fw_ports() {
    [[ "$FIREWALL" == yes ]] || return 2
    local v; v=$(ui_checks "Allow incoming" "$FW_PORTS" "${FW_OPTIONS[@]}") || return 1
    FW_PORTS="$v"
}

pick_autoupdate() {
    ui_pick "Auto-update  (checks GitHub for a newer Waterbear each time you log in)" "$AUTO_UPDATE" \
        "ask   a notification with an Update now button (full update: snapshot · system · Waterbear)::ask" \
        "auto  install the new Waterbear by itself, then tell you (system packages stay manual: they need your password)::auto" \
        "off   never check; update from this menu yourself::off"
}

pick_idle()     { ui_steps st_idle_preset st_idle_custom st_saver st_saver_battery; }
pick_firewall() { ui_steps st_fw_on st_fw_ports; }

dark_set() {  # dark_set yes|no
    DARK_MODE="$1"; state_save
    if [[ "$DESKTOP" == yes ]]; then
        need_sudo; firefox_dark_apply
        apply_all
    fi
    ok "Dark mode: $([[ $DARK_MODE == yes ]] && echo on || echo "off (light)") · Firefox and apps that were open pick it up when they restart."
}

# ---------------------------------------------------------------------------
# The Super+Alt+Space shortcut
# ---------------------------------------------------------------------------
menu_term_cmd() {  # a terminal command that opens the menu, for Hyprland configs that aren't Waterbear's
    local t
    for t in kitty foot alacritty ghostty wezterm xterm; do command -v "$t" > /dev/null && break; t=""; done
    case "$t" in
        kitty)     echo "kitty --class waterbear-menu -e waterbear" ;;
        foot)      echo "foot --app-id waterbear-menu waterbear" ;;
        alacritty) echo "alacritty --class waterbear-menu -e waterbear" ;;
        ghostty)   echo "ghostty --class=waterbear-menu -e waterbear" ;;
        wezterm)   echo "wezterm start --class waterbear-menu waterbear" ;;
        xterm)     echo "xterm -class waterbear-menu -e waterbear" ;;
        *)         echo "kitty --class waterbear-menu -e waterbear" ;;
    esac
}

# Puts the shortcut where it works: Waterbear's own Hyprland config when the desktop is installed,
# otherwise a marked block at the end of your own Hyprland config (removed again by "off").
shortcut_strip() {  # removes the block Waterbear added to your own Hyprland config
    local f
    for f in "$HOME/.config/hypr/hyprland.conf" "$HOME/.config/hypr/hyprland.lua"; do
        if [[ -f "$f" ]] && grep -q '>>> waterbear >>>' "$f"; then
            sed -i '/>>> waterbear >>>/,/<<< waterbear <<</d' "$f"
            sed -i -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$f"   # and the blank lines it left at the end
        fi
    done
    return 0
}

shortcut_apply() {
    local own=true
    [[ "$DESKTOP" == yes && "$SCHEME" != old_theme ]] && own=false
    shortcut_strip
    if ! $own; then apply_all > /dev/null; return 0; fi
    [[ "$MENU_KEY" == yes ]] || return 0
    local cmd; cmd=$(menu_term_cmd)
    if [[ -f "$HOME/.config/hypr/hyprland.lua" ]]; then
        printf '\n-- >>> waterbear >>>  (added by Waterbear; remove with: waterbear shortcut off)\nhl.bind("SUPER + ALT + space", hl.dsp.exec_cmd("%s"))\n-- <<< waterbear <<<\n' "$cmd" >> "$HOME/.config/hypr/hyprland.lua"
        ok "Super + Alt + Space added to ~/.config/hypr/hyprland.lua"
    elif [[ -f "$HOME/.config/hypr/hyprland.conf" ]]; then
        printf '\n# >>> waterbear >>>  (added by Waterbear; remove with: waterbear shortcut off)\nbind = SUPER ALT, space, exec, %s\n# <<< waterbear <<<\n' "$cmd" >> "$HOME/.config/hypr/hyprland.conf"
        ok "Super + Alt + Space added to ~/.config/hypr/hyprland.conf"
    else
        info "No Hyprland config found, so the shortcut gets set up when you install the Waterbear desktop."
        return 0
    fi
    [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && hyprctl reload > /dev/null 2>&1 || true
}

cmd_shortcut() {  # waterbear shortcut on|off
    state_load
    case "${1:-}" in
        on)  MENU_KEY=yes ;;
        off) MENU_KEY=no ;;
        *)   die "Use: waterbear shortcut on|off" ;;
    esac
    state_save; shortcut_apply
    ok "Super + Alt + Space: $([[ $MENU_KEY == yes ]] && echo on || echo off)"
}

# Run by install.sh once the tool is in place: the one question, then how to open Waterbear
cmd_installed() {
    state_load
    local ask=true a
    for a in "$@"; do
        case "$a" in --yes|-y) ask=false ;; --no-shortcut) ask=false; MENU_KEY=no ;; esac
    done
    $INTERACTIVE || ask=false
    scheme_load "$SCHEME"; ui_colors
    step "Waterbear $WB_VERSION is installed"
    if $ask; then
        if ui_confirm "Add the Super + Alt + Space shortcut to open Waterbear?" y; then MENU_KEY=yes; else MENU_KEY=no; fi
    fi
    state_save
    shortcut_apply
    echo
    info "Open Waterbear any time:"
    info "  • type  waterbear  in any terminal (or a TTY)"
    if [[ "$MENU_KEY" == yes ]]; then
        if [[ "$DESKTOP" == yes || -f "$HOME/.config/hypr/hyprland.conf" || -f "$HOME/.config/hypr/hyprland.lua" ]]; then
            info "  • or press  Super + Alt + Space"
        else
            info "  • or press  Super + Alt + Space  (once the Waterbear desktop is installed)"
        fi
    fi
    if [[ "$DESKTOP" != yes ]]; then
        echo
        info "Nothing on your desktop was changed. In the menu you can install apps right away,"
        info "and get the whole Waterbear desktop (Hyprland, bar, themes) from: Desktop → Install."
    fi
}

# ---------------------------------------------------------------------------
# Installing the desktop
# ---------------------------------------------------------------------------
BASE_PKGS=(
    git base-devel nano less jq xdg-utils libnotify fastfetch gum fzf btop
    hyprland xdg-desktop-portal-hyprland xdg-desktop-portal-gtk hyprpolkitagent qt5-wayland qt6-wayland qt6ct
    gnome-themes-extra papirus-icon-theme dconf hyprlock hypridle hyprsunset hyprshutdown
    kitty firefox thunar rofi rofi-calc rofi-emoji wtype
    swaync cliphist wl-clipboard grim slurp swappy brightnessctl playerctl pipewire-jack
    ttf-jetbrains-mono-nerd noto-fonts noto-fonts-emoji
)

# Packages a newer Waterbear needs that an older install doesn't have yet (e.g. papirus-icon-theme, qt6ct).
# Installed when sudo is already unlocked (during `waterbear update`), otherwise you're told what's missing.
desktop_pkgs_fix() {
    [[ "$DESKTOP" == yes ]] || return 0
    local missing; missing=$(pacman -T "${BASE_PKGS[@]}" 2> /dev/null | tr '\n' ' ' || true)
    [[ -n "${missing// /}" ]] || return 0
    if sudo -n true 2> /dev/null; then
        info "Installing what this version of Waterbear uses: $missing"
        # shellcheck disable=SC2086
        pac $missing || warn "Couldn't install: $missing (try: sudo pacman -S $missing)"
    else
        warn "This version of Waterbear also uses: $missing"
        info "Install them with: sudo pacman -S $missing   (or run: waterbear update)"
    fi
    return 0
}

setup_summary() {
    local fw="off"; [[ "$FIREWALL" == yes ]] && fw="on (open: ${FW_PORTS:-nothing})"
    printf '%s\n' \
        "  Looks       $SCHEME${ACCENT:+ ($ACCENT)} · $([[ $DARK_MODE == yes ]] && echo dark || echo light) mode · $WALLPAPER background · $BAR bar · $PROMPT prompt · $USER_SHELL shell" \
        "  Keybinds    $KEYBINDS$([[ $MENU_KEY == yes ]] && echo " · Super+Alt+Space opens this menu")" \
        "  System      snapper: $SNAPPER (weekly: $SNAPPER_WEEKLY) · firewall: $fw · yay: $YAY" \
        "  Screensaver $SAVER · $IDLE_SAVER/$IDLE_LOCK/$IDLE_OFF/$IDLE_SUSPEND min" \
        "  Updates     auto-update: $AUTO_UPDATE" \
        "  Login       $([[ $LOGIN == screen ]] && echo "hyprlock login screen" || echo "text login on tty1")"
}

old_configs_found() {
    local d; for d in "${MANAGED_DIRS[@]}" "${MANAGED_FILES[@]}"; do [[ -e "$HOME/.config/$d" ]] && return 0; done
    return 1
}

# Desktop → Install: what will happen, what to do with your current configs, then go
desktop_install() {
    ui_title "Install the desktop"
    info "This installs Hyprland and the Waterbear desktop with these settings"
    info "(change any of them first in Look & feel, Keyboard and System; all of it can change later):"; echo
    setup_summary; echo
    if old_configs_found; then
        local o
        o=$(ui_pick "You already have configs here (hypr, kitty, waybar, gtk...). What should happen to them?" save \
            "Save them as a theme called old_theme (switch back to them any time in Theme)::save" \
            "Delete them::delete") || return 0
        OLD_CONFIGS="$o"
    fi
    ui_confirm "Install the Waterbear desktop now?" y || return 0
    setup_run
    ui_pause
}

setup_run() {
    need_sudo
    step "Updating the system"
    sudo pacman -Syu --noconfirm

    step "Installing the desktop"
    local pkgs=("${BASE_PKGS[@]}")
    [[ "$BAR" != none ]] && pkgs+=(waybar)
    [[ "$PROMPT" != off ]] && pkgs+=(starship)
    [[ "$USER_SHELL" == fish ]] && pkgs+=(fish)
    # shellcheck disable=SC2207
    pkgs+=($(wallpaper_pkgs))
    pac "${pkgs[@]}"

    step "Dark mode for Firefox"
    firefox_dark_apply

    if [[ "$YAY" == yes ]]; then install_yay; fi

    step "Writing configs ($SCHEME)"
    [[ "$SCHEME" == old_theme ]] && SCHEME=abyss
    prepare_old_configs "$OLD_CONFIGS"
    DESKTOP=yes
    add_app btop; add_app clock
    state_save
    apply_all
    shortcut_apply

    local id
    for id in ${SETUP_APPS:-}; do
        case "$id" in steam|clock) continue ;; esac
        has_app "$id" || install_app "$id" || true
    done
    state_save
    apply_all > /dev/null   # again, so app themes (btop, Neovim) and shell aliases are written

    [[ "$SNAPPER" == yes ]] && snapper_setup
    login_apply
    fw_apply
    if [[ " ${SETUP_APPS:-} " == *" steam "* ]]; then install_app steam || true; fi
    state_save
    if [[ "$SNAPPER" == yes ]]; then snapshot_now "waterbear-setup-$(date +%F)" || true; fi

    step "Done: the Waterbear desktop is installed"
    info "Waterbear menu: Super + Alt + Space (or type: waterbear)"
    info "  themes · background · bar · apps · every keyboard shortcut · snapshots · update"
    case "$KEYBINDS" in
        waterbear) info "Keybind cheat sheet: Super + H  (search it: Super + Shift + K)" ;;
        omarchy)   info "Keybind cheat sheet: Super + K" ;;
        *)         info "Keybind cheat sheet: Super + Alt + Space → Keyboard → Shortcut list" ;;
    esac
    if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
        info "You're in Hyprland already; most changes are live. Log out and back in for the rest."
    elif [[ "$LOGIN" == screen ]]; then
        info "Reboot to get the hyprlock login screen:  reboot"
    else
        info "Reboot, or log out and log in on tty1; Hyprland starts by itself."
    fi
}

cmd_setup() {
    state_load
    local steam=false
    SETUP_APPS=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --yes|-y)       INTERACTIVE=false ;;
            --scheme)       SCHEME="$2"; shift ;;
            --accent)       ACCENT="$2"; shift ;;
            --wallpaper)    WALLPAPER="$2"; shift ;;
            --bar)          BAR="$2"; shift ;;
            --prompt)       PROMPT="$2"; shift ;;
            --shell)        USER_SHELL="$2"; shift ;;
            --keybinds)     KEYBINDS="$2"; shift ;;
            --light)        DARK_MODE=no ;;
            --apps)         SETUP_APPS="$2"; shift ;;
            --steam)        steam=true ;;
            --yay)          YAY=yes ;;
            --login-screen) LOGIN=screen ;;
            --text-login)   LOGIN=text ;;
            --no-snapper)   SNAPPER=no; SNAPPER_WEEKLY=no ;;
            --no-firewall)  FIREWALL=no ;;
            --delete-old)   OLD_CONFIGS=delete ;;
            --auto-update)  AUTO_UPDATE="$2"; shift ;;
            --no-shortcut)  MENU_KEY=no ;;
            *) die "Unknown option: $1 (see: waterbear help)" ;;
        esac
        shift
    done
    $steam && SETUP_APPS+=" steam"
    on_arch || die "Waterbear is for Arch Linux."
    scheme_load "$SCHEME"
    [[ "$BAR" =~ ^(dashboard|islands|terminal|none)$ ]] || die "Unknown bar '$BAR'."
    [[ "$WALLPAPER" =~ ^(solid|picture|grid|orbit|logo|cmatrix|cava)$ ]] || die "Unknown wallpaper '$WALLPAPER'."
    [[ "$PROMPT" =~ ^(minimal|info|hacker|off)$ ]] || die "Unknown prompt '$PROMPT'."
    [[ "$USER_SHELL" =~ ^(bash|fish)$ ]] || die "Unknown shell '$USER_SHELL' (bash or fish)."
    [[ "$KEYBINDS" =~ ^(waterbear|omarchy|default)$ ]] || die "Unknown keybinds '$KEYBINDS' (waterbear, omarchy or default)."
    [[ "$AUTO_UPDATE" =~ ^(off|ask|auto)$ ]] || die "Unknown auto-update '$AUTO_UPDATE' (off, ask or auto)."
    if $INTERACTIVE; then
        scheme_load "$SCHEME"; ui_colors
        desktop_install
    else
        setup_summary
        setup_run
    fi
}

# ---------------------------------------------------------------------------
# The menu (Super+Alt+Space / `waterbear`). ↑↓ move · → open · ← back
# ---------------------------------------------------------------------------
lbl_theme()  { echo "Theme        $SCHEME${ACCENT:+ ($ACCENT)}"; }
lbl_dark()   { echo "Dark mode    $([[ $DARK_MODE == yes ]] && echo on || echo "off (light)")"; }
lbl_wall()   { echo "Background   $WALLPAPER$([[ $WALLPAPER == picture && -n $WALL_IMAGE ]] && echo " ($(basename "$WALL_IMAGE"))") · lock screen: $LOCK_BG"; }
lbl_bar()    { echo "Status bar   $BAR"; }
lbl_prompt() { echo "Prompt       $PROMPT"; }
lbl_shell()  { echo "Shell        $USER_SHELL"; }
lbl_idle()   { echo "Screensaver  $SAVER · lock after ${IDLE_LOCK} min"; }
lbl_fw()     { echo "Firewall     $([[ $FIREWALL == yes ]] && echo "on · open: ${FW_PORTS:-nothing}" || echo off)"; }
lbl_login()  { echo "Login        $([[ $LOGIN == screen ]] && echo hyprlock || echo "text on tty1")"; }
lbl_auto()   { echo "Auto-update  $AUTO_UPDATE · checks GitHub at login and every 3 hours"; }
lbl_system() { echo "Snapper/yay  snapper: $SNAPPER · weekly snapshot: $SNAPPER_WEEKLY · yay: $YAY"; }

menu_desktop() {
    local last=install
    while true; do
        ui_title "Desktop"
        local c
        if [[ "$DESKTOP" != yes ]]; then
            info "Not installed yet. Installing adds Hyprland, a status bar, kitty, Rofi, Thunar,"
            info "lock screen, notifications and themes, with the settings from the other menus."; echo
            c=$(ui_pick "Desktop" "$last" \
                "Install the Waterbear desktop  ▶::install" \
                "$(lbl_login)::login") || return 0
        else
            c=$(ui_pick "Desktop  (installed)" "$last" \
                "Re-apply all configs  rewrite them from your settings::apply" \
                "$(lbl_login)::login" \
                "Install again  runs the desktop install with your settings::install") || return 0
        fi
        last="$c"
        case "$c" in
            install) desktop_install ;;
            apply)   apply_all; ok "Configs refreshed."; ui_pause ;;
            login)   local l; l=$(ui_pick "Login" "$LOGIN" \
                         "Text login on tty1 (type username + password, Hyprland starts)::text" \
                         "hyprlock as the login screen (single user: boots locked, same look as your lock screen)::screen") || continue
                     LOGIN="$l"; state_save
                     if [[ "$DESKTOP" == yes ]]; then need_sudo; login_apply; else desktop_needed || true; fi
                     ui_pause ;;
        esac
    done
}

menu_look() {
    local last=theme
    while true; do
        scheme_load "$SCHEME"; ui_colors
        ui_title "Look & feel"
        local c
        c=$(ui_pick "Look & feel" "$last" \
            "$(lbl_theme)::theme" \
            "$(lbl_dark)::dark" \
            "$(lbl_wall)::wall" \
            "$(lbl_bar)::bar" \
            "$(lbl_prompt)::prompt" \
            "$(lbl_shell)::shell") || return 0
        last="$c"
        case "$c" in
            theme)  menu_theme ;;
            dark)   local d; d=$(ui_pick "Dark mode  (GTK and Qt apps, Firefox, file pickers)" "$DARK_MODE" \
                        "On   dark apps::yes" "Off  light apps::no") || continue
                    dark_set "$d"; ui_pause ;;
            wall)   cmd_background; ui_pause ;;
            bar)    local b; b=$(pick_bar) || continue; BAR="$b"
                    [[ "$BAR" != none && "$DESKTOP" == yes ]] && ! pkg_installed waybar && { need_sudo; pac waybar; }
                    state_save; apply_all; ui_pause ;;
            prompt) local pr; pr=$(pick_prompt) || continue; PROMPT="$pr"
                    [[ "$PROMPT" != off && "$DESKTOP" == yes ]] && ! pkg_installed starship && { need_sudo; pac starship; }
                    state_save; apply_all; [[ "$DESKTOP" == yes ]] && info "Open a new terminal to see it."; ui_pause ;;
            shell)  local sh; sh=$(pick_shell) || continue; USER_SHELL="$sh"
                    [[ "$USER_SHELL" == fish && "$DESKTOP" == yes ]] && ! pkg_installed fish && { need_sudo; pac fish; }
                    state_save; apply_all; [[ "$DESKTOP" == yes ]] && info "Open a new terminal to see it."; ui_pause ;;
        esac
    done
}

menu_install() {
    local last="${APP_SECTIONS[0]}"
    while true; do
        ui_title "Install"
        apps_reconcile
        local opts=("-- Apps (✓ = already installed)") sec ids id n have
        for sec in "${APP_SECTIONS[@]}"; do
            n=0; have=0
            while IFS= read -r id; do ((n++)) || true; app_is_installed "$id" && { ((have++)) || true; }; done < <(section_ids "$sec")
            opts+=("$(printf '%-17s' "$sec") $have of $n installed::$sec")
        done
        opts+=("-- More"
               "Web apps           websites in their own window (you add them)::@webapps"
               "Search packages    anything in the official Arch repos::@search"
               "Search the AUR     official repos + AUR (installs yay if needed)::@aur"
               "Remove packages    pick from what you installed::@remove")
        local c
        c=$(ui_pick "Install" "$last" "${opts[@]}") || { state_save; return 0; }
        last="$c"
        case "$c" in
            @webapps) webapps_menu ;;
            @search)  pkg_search repo ;;
            @aur)     pkg_search aur ;;
            @remove)  pkg_remove ;;
            *)        ui_title "Install · $c"
                      if apps_section "$c"; then state_save; apply_quiet > /dev/null; ui_pause; fi ;;
        esac
    done
}

menu_keyboard() {
    local last=keys
    while true; do
        ui_title "Keyboard"
        local c
        c=$(ui_pick "Keyboard" "$last" \
            "Keybind set    $KEYBINDS::keys" \
            "Shortcut list  every shortcut in the $KEYBINDS set::list" \
            "Menu shortcut  Super+Alt+Space opens this menu: $([[ $MENU_KEY == yes ]] && echo on || echo off)::menukey") || return 0
        last="$c"
        case "$c" in
            keys)    local kb; kb=$(pick_keybinds) || continue; KEYBINDS="$kb"; state_save; apply_all
                     [[ "$DESKTOP" == yes ]] && ok "Shortcuts switched. See them all: Keyboard → Shortcut list."; ui_pause ;;
            list)    show_shortcuts ;;
            menukey) local m; m=$(ui_pick "Super + Alt + Space opens the Waterbear menu" "$MENU_KEY" "On::yes" "Off::no") || continue
                     MENU_KEY="$m"; state_save; shortcut_apply; ui_pause ;;
        esac
    done
}

menu_system() {
    local last=snaps
    while true; do
        ui_title "System"
        local c
        c=$(ui_pick "System" "$last" \
            "Snapshots    list · take one · restore::snaps" \
            "$(lbl_fw)::fw" \
            "$(lbl_idle)::idle" \
            "$(lbl_monitors)::monitors" \
            "$(lbl_system)::system") || return 0
        last="$c"
        case "$c" in
            snaps)    snapshots_menu ;;
            fw)       pick_firewall || continue; need_sudo; fw_apply; state_save; ui_pause ;;
            idle)     pick_idle || continue; state_save; apply_all; ok "Saved."; ui_pause ;;
            monitors) cmd_monitors ;;
            system)   cmd_system ;;
        esac
    done
}

menu_update() {
    local last=update
    while true; do
        ui_title "Update"
        local c
        c=$(ui_pick "Update" "$last" \
            "Update now   snapshot · system packages · Waterbear (you have $WB_VERSION)::update" \
            "$(lbl_auto)::auto" \
            "Check now    and see the last checks (~/.cache/waterbear/autoupdate.log)::check") || return 0
        last="$c"
        case "$c" in
            update) waterbear_update || true; ui_pause
                    exec "$WB_HOME/waterbear" menu ;;   # reopen with the (possibly new) version
            auto)   local au; au=$(pick_autoupdate) || continue; AUTO_UPDATE="$au"; state_save
                    ok "Auto-update: $AUTO_UPDATE (checks at login and every 3 hours)"; ui_pause ;;
            check)  ui_title "Update check"
                    local rc=0; AU_VERBOSE=true; autoupdate_once 1 || rc=$?
                    echo; info "Last checks:"; tail -n 8 "$WB_AUTO_LOG" 2> /dev/null | sed 's/^/      /'
                    ui_pause
                    (( rc == 3 )) && exec "$WB_HOME/waterbear" menu   # reopen with the new version
                    ;;
        esac
    done
}

cmd_menu() {
    state_load
    $INTERACTIVE || die "The menu needs gum and a terminal: sudo pacman -S gum"
    apps_reconcile; state_save
    local last=look
    [[ "$DESKTOP" != yes ]] && last=desktop
    while true; do
        scheme_load "$SCHEME"; ui_colors
        ui_title "Menu"
        local d="installed"; [[ "$DESKTOP" != yes ]] && d="not installed yet → install it here"
        local c
        c=$(ui_pick "What do you want to do?" "$last" \
            "Desktop       $d::desktop" \
            "Look & feel   theme · dark mode · background · bar · prompt · shell::look" \
            "Install       apps by category · web apps · search any package::install" \
            "Keyboard      $KEYBINDS shortcuts · shortcut list · menu shortcut::keyboard" \
            "System        snapshots · firewall · screensaver · monitors · snapper/yay::system" \
            "Update        system + Waterbear (you have $WB_VERSION)::update" \
            "Quit::quit") || exit 0
        last="$c"
        case "$c" in
            desktop)  menu_desktop ;;
            look)     menu_look ;;
            install)  menu_install ;;
            keyboard) menu_keyboard ;;
            system)   menu_system ;;
            update)   menu_update ;;
            quit)     exit 0 ;;
        esac
    done
}

cmd_system() {
    local cur sel
    cur="$( [[ $SNAPPER == yes ]] && echo snapper; [[ $SNAPPER_WEEKLY == yes ]] && echo weekly; [[ $YAY == yes ]] && echo yay )"
    sel=$(ui_checks "System" "$cur" \
        "Snapper snapshots (btrfs: roll back from the boot menu)::snapper" "Weekly automatic snapshot (needs Snapper)::weekly" "yay (AUR helper)::yay") || return 0
    need_sudo
    if [[ " $sel " == *" snapper "* && "$SNAPPER" != yes ]]; then SNAPPER=yes; snapper_setup; fi
    if [[ " $sel " != *" snapper "* ]]; then SNAPPER=no; fi
    local w=no; [[ " $sel " == *" weekly "* && "$SNAPPER" == yes ]] && w=yes
    if [[ "$w" != "$SNAPPER_WEEKLY" ]]; then SNAPPER_WEEKLY=$w; weekly_snapshot_set "$w"; fi
    if [[ " $sel " == *" yay "* && "$YAY" != yes ]]; then YAY=yes; install_yay; fi
    [[ " $sel " != *" yay "* ]] && YAY=no
    state_save; ui_pause
}

case "${1:-menu}" in
    menu)     cmd_menu ;;
    setup)    shift; cmd_setup "$@" ;;
    installed) shift; cmd_installed "$@" ;;
    theme)    shift; cmd_theme "${1:-}" "${2:-}" ;;
    background|wallpaper) state_load; scheme_load "$SCHEME"; ui_colors; ui_title "Background"; cmd_background ;;
    transparency) state_load
              if [[ -n "${2:-}" ]]; then
                  for v in "$2" "${3:-$SEE_UNFOCUSED}"; do
                      [[ "$v" =~ ^[0-9]+$ ]] && (( v <= 100 )) || die "Use: waterbear transparency FOCUSED OTHERS (each 0-100, 0 = solid)"
                  done
                  SEE_FOCUSED="$2"; SEE_UNFOCUSED="${3:-$SEE_UNFOCUSED}"
              else
                  $INTERACTIVE || die "Use: waterbear transparency FOCUSED OTHERS (each 0-100, 0 = solid)"
                  scheme_load "$SCHEME"; ui_colors; pick_transparency || exit 0
              fi
              scheme_load "$SCHEME"; transparency_set ;;
    dark)     state_load
              case "${2:-}" in on) v=yes ;; off) v=no ;; "") [[ "$DARK_MODE" == yes ]] && v=no || v=yes ;; *) die "Use: waterbear dark [on|off]" ;; esac
              scheme_load "$SCHEME"; dark_set "$v" ;;
    bar)      state_load; BAR="${2:-$(pick_bar)}"
              [[ "$BAR" =~ ^(dashboard|islands|terminal|none)$ ]] || die "Unknown bar '$BAR'."
              state_save; apply_all; ok "Bar: $BAR" ;;
    shell)    state_load; v="${2:-$(pick_shell)}" || exit 0
              [[ "$v" =~ ^(bash|fish)$ ]] || die "Unknown shell '$v' (bash or fish)."
              USER_SHELL="$v"; [[ "$v" == fish && "$DESKTOP" == yes ]] && ! pkg_installed fish && { need_sudo; pac fish; }
              state_save; apply_all; ok "Shell: $USER_SHELL" ;;
    apps)     state_load; $INTERACTIVE || die "This needs gum and a terminal."; scheme_load "$SCHEME"; ui_colors; menu_install ;;
    update)   state_load; waterbear_update ;;
    autoupdate) case "${2:-}" in
                    off|ask|auto) state_load; AUTO_UPDATE="$2"; state_save; ok "Auto-update: $AUTO_UPDATE" ;;
                    *)            cmd_autoupdate "${2:-}" ;;
                esac ;;
    monitors) cmd_monitors ;;
    snapshot) state_load; snapshot_now "${2:-manual-$(date +%F)}" ;;
    apply)    state_load
              [[ -t 1 ]] && APPLY_VERBOSE=true   # in a terminal (e.g. during an update): show each step
              desktop_pkgs_fix
              apply_all; if [[ "$DESKTOP" == yes ]]; then ok "Configs refreshed."; fi ;;
    shortcut) cmd_shortcut "${2:-}" ;;
    webapp-open) [[ -n "${2:-}" ]] || die "Use: waterbear webapp-open URL"; webapp_open "$2" ;;
    version|-v|--version) echo "Waterbear $WB_VERSION" ;;
    shortcuts) state_load; show_shortcuts ;;
    help|-h|--help) awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$WB_SELF" ;;
    *)        die "Unknown command: $1 (try: waterbear help)" ;;
esac
